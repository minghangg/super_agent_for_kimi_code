  "defaults": {"mode": "observe", "creation_mode": "pm_created"},
  "projects": {
    "example-project": {
      "repo": "placeholder/example-project",
      "cwd": ".",
      "mode": "observe",
      "creation_mode": "pm_created",
      "issues": [1],
      "actions": ["collect", "reconcile", "bus_inject"],
